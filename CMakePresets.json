{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "unix-debug",
      "displayName": "Linux/macOS Debug",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" },
      "condition": { "type": "inList", "string": "${hostSystemName}", "list": ["Linux", "Darwin"] }
    },
    {
      "name": "unix-release",
      "displayName": "Linux/macOS Release",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
      "condition": { "type": "inList", "string": "${hostSystemName}", "list": ["Linux", "Darwin"] }
    },
    {
      "name": "windows",
      "displayName": "Windows (Visual Studio)",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "unix-debug", "configurePreset": "unix-debug" },
    { "name": "unix-release", "configurePreset": "unix-release" },
    { "name": "windows-debug", "configurePreset": "windows", "configuration": "Debug" },
    { "name": "windows-release", "configurePreset": "windows", "configuration": "Release" },
    { "name": "unix-debug-run", "configurePreset": "unix-debug", "targets": ["run"] },
    { "name": "unix-debug-clean", "configurePreset": "unix-debug", "targets": ["clean"] },
    { "name": "windows-debug-run", "configurePreset": "windows", "configuration": "Debug", "targets": ["run"] },
    { "name": "windows-debug-clean", "configurePreset": "windows", "configuration": "Debug", "targets": ["clean"] }
  ],
  "testPresets": [
    { "name": "unix-debug", "configurePreset": "unix-debug", "output": { "outputOnFailure": true } },
    { "name": "unix-release", "configurePreset": "unix-release", "output": { "outputOnFailure": true } },
    { "name": "windows-debug", "configurePreset": "windows", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "windows-release", "configurePreset": "windows", "configuration": "Release", "output": { "outputOnFailure": true } }
  ],
  "workflowPresets": [
    {
      "name": "unix-debug",
      "displayName": "Configure, build and test (Linux/macOS Debug)",
      "steps": [
        { "type": "configure", "name": "unix-debug" },
        { "type": "build", "name": "unix-debug" },
        { "type": "test", "name": "unix-debug" }
      ]
    },
    {
      "name": "windows-debug",
      "displayName": "Configure, build and test (Windows Debug)",
      "steps": [
        { "type": "configure", "name": "windows" },
        { "type": "build", "name": "windows-debug" },
        { "type": "test", "name": "windows-debug" }
      ]
    }
  ]
}
